#!/usr/bin/env bash
# herdr-crew: deterministic crew launcher for Herdr. All logic lives here.
# CREW_DRY_RUN=1 prints every mutating herdr/git/tsk call ("+ ..." on stderr) instead of running it.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RANKS="lead manager member inspector"
die() { printf '%sherdr-crew: %s%s\n' "$U_RED" "$*" "$U_OFF" >&2; exit 1; }
# mut CMD...: mutating command (dry-run: echo only)
mut() { if [[ -n "${CREW_DRY_RUN:-}" ]]; then echo "+ $*" >&2; else "$@"; fi; }
# mutj FAKE_JSON CMD...: mutating command whose JSON stdout is needed
mutj() { local fake=$1; shift; if [[ -n "${CREW_DRY_RUN:-}" ]]; then echo "+ $*" >&2; echo "$fake"; else "$@"; fi; }

# UX layer: colour, symbols, help text, completions. Sourced before any dependency
# check, and the dispatch handles the pure-text paths before it checks for jq.
source "$ROOT/lib/ux.sh"

# Repo and slug. Slug = 6 chars of the basename + 4 hex of the repo path, so same-named repos differ.
# Panes crew creates carry CREW_* so worktree subshells keep the main repo's identity.
REPO="${CREW_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)}"
SLUG="${CREW_SLUG:-$(printf %s "$(basename "$REPO")" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | cut -c1-6)-$(printf %s "$REPO" | shasum | cut -c1-4)}"
[[ "$SLUG" =~ ^[a-z] ]] || SLUG="x$SLUG"
ME="${CREW_AGENT:-user}"
SDIR="$HOME/.herdr/crew/$SLUG"  # per-crew state: agent meta and briefs (restart), handoff files

project_base() { if [[ -d "${CONFIG_ROOT:-$REPO}/.herdr-crew" ]]; then printf '%s' "${CONFIG_ROOT:-$REPO}/.herdr-crew"; else printf '%s' "$ROOT"; fi; }
pfile() { echo "$(project_base)/personas/$1.md"; }
team_dir() { printf '%s/teams' "$(project_base)"; }
load_definitions() { definitions_load "$(project_base)" || die "invalid project agent definitions"; }
job_exists() { [[ "$1" =~ ^[a-z][a-z0-9-]*$ && -f "$(project_base)/agents/$1/agent.json" && "$1" != crew-lead && "$1" != crew-manager && "$1" != crew-member && "$1" != crew-inspector ]]; }
job_meta() { jq -r --arg k "$2" '.[$k] // empty | if type == "array" then join(", ") else . end' "$(project_base)/agents/$1/agent.json"; }
# fm KEY FILE: frontmatter value
fm() { awk -v k="$1" 'NR==1&&/^---/{f=1;next} f&&/^---/{exit} f&&$0~"^"k":"{sub("^"k":[ ]*","");print;exit}' "$2"; }
# body FILE: text after frontmatter
body() { awk 'NR==1&&/^---/{f=1;next} f&&/^---/{f=0;p=1;next} p' "$1"; }
# conf TEAM KEY
conf() { awk -F= -v k="$2" '$1==k{sub("^[^=]*=","");print;exit}' "$(team_dir)/$1.conf"; }
persona_rank() { if job_exists "$1"; then job_meta "$1" profile; else fm rank "$(pfile "$1")"; fi; }
persona_names() { ls "$(project_base)/personas" | sed 's/\.md$//' | tr '\n' ' '; }
# jobs_for RANK: job personas (those with rank: RANK)
jobs_for() { local f id; for f in "$(project_base)"/agents/*/agent.json; do id=${f%/agent.json}; id=${id##*/}; job_exists "$id" || continue; [[ "$(job_meta "$id" profile)" == "$1" ]] && printf '%s ' "$id"; done; return 0; }
# team_of JOB: team whose members include the job persona
team_of() {
  local t m
  for t in "$(team_dir)"/*.conf; do
    for m in $(conf "$(basename "$t" .conf)" members); do
      if [[ "$m" == *@"$1" ]]; then basename "$t" .conf; return 0; fi
    done
  done
  return 1
}
# team_jobs TEAM: job personas of a team
team_jobs() { local m; for m in $(conf "$1" members); do if [[ "$m" == *@* ]]; then echo "${m#*@}"; fi; done; }
# all_jobs: job personas of every team
all_jobs() { local t; for t in "$(team_dir)"/*.conf; do team_jobs "$(basename "$t" .conf)"; done; }
# check_domain NAME: must be a domain persona (no rank)
check_domain() {
  [[ "$1" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid persona '$1'"
  [[ -f "$(pfile "$1")" ]] || die "unknown persona '$1'. ranks: $RANKS. personas: $(persona_names)"
  [[ -z "$(persona_rank "$1")" ]] || die "'$1' is a job persona, not a domain persona"
}
# parse_spec SPEC: sets RANK, JOB (job persona), DOMAINS (space list). Dies before any command runs.
parse_spec() {
  local spec=$1 rank_part="" plist="" p pr
  RANK=""; JOB=""; DOMAINS=""
  if [[ "$spec" == *@* ]]; then rank_part=${spec%%@*}; plist=${spec#*@}; plist=${plist//+/ }
  elif [[ " $RANKS " == *" $spec "* ]]; then rank_part=$spec
  else plist=$spec
  fi
  for p in $plist; do
    [[ "$p" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid persona '$p'"
    [[ -f "$(pfile "$p")" ]] || job_exists "$p" || die "unknown persona '$p'. ranks: $RANKS. personas: $(persona_names)"
    pr=$(persona_rank "$p")
    if [[ -n "$pr" ]]; then
      [[ -z "$JOB" ]] || die "one job persona per spec (got $JOB and $p)"
      JOB=$p; rank_part=${rank_part:-$pr}
    else
      DOMAINS="${DOMAINS:+$DOMAINS }$p"
    fi
  done
  [[ -n "$rank_part" ]] || die "spec '$spec': name a rank (member@driver) or a job persona (driver). ranks: $RANKS"
  [[ " $RANKS " == *" $rank_part "* ]] || die "unknown rank '$rank_part'. ranks: $RANKS"
  RANK=$rank_part
  if [[ -n "$JOB" ]]; then
    pr=$(persona_rank "$JOB")
    [[ "$pr" == "$RANK" ]] || die "persona '$JOB' is a $pr job; use $pr@$JOB"
  else
    [[ "$RANK" == lead ]] || die "rank '$RANK' needs a job persona: $(jobs_for "$RANK")"
  fi
}
agent_name() { echo "$SLUG-$(echo "$1" | tr '[:upper:]' '[:lower:]')-$2" | cut -c1-32; }
# set_env NAME TASK JOB [SELECTION]: fills ENVV with K=V assignments for an app argv.
set_env() {
  local rank job="" selection=${4:-}
  rank=$3
  if [[ -n "$rank" && " $RANKS " != *" $rank "* ]]; then
    job=$rank
    rank=$(persona_rank "$job")
  fi
  ENVV=("CREW_SLUG=$SLUG" "CREW_TASK=$2" "CREW_AGENT=$1" "CREW_MANAGER=$SLUG-manager" "CREW_CTX_LIMIT=${CREW_CTX_LIMIT:-135000}" "CREW_REPO=$REPO" "CREW_WS=${WS-${CREW_WS:-${HERDR_WORKSPACE_ID:-}}}")
  if [[ -n "$rank" ]]; then
    if [[ -n "$selection" ]]; then AGENT_JSON=$selection; selection_fields; else agent_selection "$rank" "$job"; fi
    if [[ "$AGENT_KIND" == opencode ]]; then
      ENVV+=("OPENCODE_CONFIG_CONTENT=$(opencode_config "$rank" "$job")")
    fi
  fi
}
# slot_list JOB DOMAINS: personas for a slot (job first); pragmatic-senior when no domain persona
slot_list() { local d=${2:-pragmatic-senior}; echo "${1:+$1 }$d"; }
# pmap_for JOB: domain personas from cmd_team's --persona args, space list
pmap_for() { local e; for e in $pmap; do if [[ "${e%%=*}" == "$1" ]]; then echo "${e#*=}" | tr '+' ' '; return 0; fi; done; }
# branch_exists BRANCH: local branch present in the repo
branch_exists() { git -C "$REPO" rev-parse --verify -q "refs/heads/$1" >/dev/null 2>&1; }
terminal_of() {
  local meta="$SDIR/$1.meta" terminal
  [[ "$1" =~ ^[a-zA-Z0-9_-]+$ && -f "$meta" ]] || return 1
  terminal=$(sed -n 's/^terminal=//p' "$meta" | head -1)
  [[ -n "$terminal" ]] || return 1
  printf '%s\n' "$terminal"
}
terminal_status() {
  local name=$1 snapshot=$2 terminal
  terminal=$(terminal_of "$name") || return 0
  jq -r --arg address "$terminal" '.terminals[]? | select(.address == $address) | .status.state // empty' <<<"$snapshot" 2>/dev/null | head -1 || true
}

# A saved Claude SessionStart hook repopulates Bash tool env after resume.
crew_env_hook() {
  local exports assignment
  set_env "$1" "$2" "${3:-}" "${4:-}"
  exports=""
  for assignment in "${ENVV[@]}"; do
    printf -v assignment '%q' "$assignment"
    exports+="export $assignment"$'\n'
  done
  printf 'if [ -n "${CLAUDE_ENV_FILE:-}" ]; then printf %%s %q >> "$CLAUDE_ENV_FILE"; fi' "$exports"
}

# axi_of FILE...: deduped `axi:` tools declared by these persona or rank files (space list)
axi_of() {
  local f a seen=""
  for f in "$@"; do
    for a in $(fm axi "$f" | tr ',' ' '); do
      case " $seen " in *" $a "*) ;; *) seen="$seen $a" ;; esac
    done
  done
  echo $seen
}

# brief NAME RANK TASK TEAMMATES INSTR CWD PERSONAS: prompt text for an agent (PERSONAS: space list, job first)
brief() {
  local name=$1 rank=$2 task=$3 mates=$4 instr=$5 cwd=$6 plist=$7 p s a first=${7%% *} pskills seen="" skills="" bodies="" axi="" axi_line="" budget runtime=""
  if job_exists "$first"; then agent_selection "$rank" "$first"; else agent_selection "$rank" ""; fi
  budget="A hook warns you when you reach it."
  if [[ "$AGENT_KIND" == opencode ]]; then
    budget="Automatic context warnings are unavailable in this runtime; monitor context and hand off before compaction."
    runtime=$(opencode_guidance)
  fi
  axi=$(jq -r '.axi // [] | join(" ")' "$(project_base)/agents/crew-$rank/agent.json")
  for p in $plist; do
    if job_exists "$p"; then axi="$axi $(job_meta "$p" axi | tr ',' ' ')"; else axi="$axi $(axi_of "$(pfile "$p")")"; fi
  done
  axi=$(printf '%s\n' "$axi" | awk '{$1=$1;print}')
  for a in $axi; do
    command -v "$a" >/dev/null 2>&1 || crew_warn "AXI tool '$a' not on PATH (run bin/install-skills)"
  done
  [[ -z "$axi" ]] || axi_line="
AXI tools (prefer these over raw CLIs; run with no args for a dashboard, follow help[] hints): $(echo $axi | sed 's/ /, /g')"
  for p in $plist; do
    if job_exists "$p"; then pskills=$(job_meta "$p" skills); else pskills=$(fm skills "$(pfile "$p")"); fi
    for s in $(printf '%s' "$pskills" | tr -d ' ' | tr ',' ' '); do
      case " $seen " in *" $s "*) ;; *)
        seen="$seen $s"
        if [[ "$AGENT_KIND" == claude ]]; then skills="$skills /$s"; else skills="$skills $s"; fi ;;
      esac
      # plugin skills (ns:name) live elsewhere; only check user skills
      [[ "$s" == *:* || -f "$HOME/.claude/skills/$s/SKILL.md" || -f "$HOME/.agents/skills/$s/SKILL.md" || -f "$HOME/.config/opencode/skills/$s/SKILL.md" || -f "$cwd/.agents/skills/$s/SKILL.md" ]] || crew_warn "skill '$s' (persona $p) not installed"
    done
    if ! job_exists "$p"; then bodies="$bodies
Persona ($p):
$(body "$(pfile "$p")")
"; fi
  done
  cat <<BRIEF
You are $name in crew "$SLUG".
Rank: $rank   Task: ${task:-none yet}   tsk project: $REPO   (task state lives in tsk)
Repo: $REPO
Working dir: $cwd
Lead: $SLUG-lead   Manager: $SLUG-manager   Teammates: ${mates:-none}
Rule: run \`herdr-crew mark <T#> <status> "<note>"\` on EVERY state change (started, blocked, review, done).
Talk to others only with \`herdr-crew say <agent> "<msg>"\`.
Messages that were busy-queued arrive as task steps tagged [msg from X to Y]: check \`tsk list <T#> --json\` after each step.
Context budget: ${CREW_CTX_LIMIT:-135000} tokens. $budget Then write your handoff with \`herdr-crew handoff "<status>" <<'EOF' ... EOF\` (goal, done, in progress, next steps, files, task number). It is saved to $SDIR/handoff-$name.md. Then stop. Your initiator restarts you with the handoff.
$runtime
Load these skills now:${skills:- none}${axi_line}

Personas adopt them for job and judgment. Rank rules win over persona.
$bodies
Instructions:
$instr
BRIEF
}

# App-owned space/tab/pane creation; hc remains the terminal control plane.
resolve_space() {
  local spaces candidate info
  spaces=$(herdr-app ls) || die "cannot list herdr-app spaces"
  WS=""
  if [[ -n "${CREW_WS:-}" ]] && jq -e --arg id "$CREW_WS" 'any(.spaces[]; .id == $id)' <<<"$spaces" >/dev/null; then
    WS=$CREW_WS
  elif [[ -n "${HC_TERMINAL_ID:-}" ]] && info=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null); then
    candidate=$(jq -r '.labels["herdr.space"] // empty' <<<"$info")
    if [[ -n "$candidate" ]] && jq -e --arg id "$candidate" 'any(.spaces[]; .id == $id)' <<<"$spaces" >/dev/null; then WS=$candidate; fi
  fi
  if [[ -z "$WS" ]]; then
    WS=$(jq -r --arg name "crew-$SLUG" '[.spaces[] | select(.name == $name) | .id][0] // empty' <<<"$spaces")
  fi
}

pane_for_terminal() {
  herdr-app ls | jq -er --arg terminal "$1" '.spaces[].tabs[].terminals[] | select(.terminal == $terminal) | .pane'
}

app_argv_json() { jq -nc --args '$ARGS.positional' -- "${ARGV[@]}"; }

# save_cmd NAME: exact argv as one shell line, so restart types the same model, effort and policy bytes.
save_cmd() {
  local name=$1 arg line=""
  for arg in "${ARGV[@]}"; do
    printf -v arg '%q' "$arg"
    line+="${line:+ }$arg"
  done
  printf '%s\n' "$line" >"$SDIR/$name.cmd" || die "cannot save agent command for $name"
}

create_space() {
  local result
  result=$(mutj '{"space":"sp-dry","tab":"tb-dry","terminal":"t-dry","pane":"p-dry"}' \
    herdr-app do space.new --name "$1" --folder "${4:-$REPO}" --tab "$2" --argv "$3") || die "cannot create app space $1"
  NEW_SPACE=$(jq -r '.space // empty' <<<"$result")
  NEW_TAB=$(jq -r '.tab // empty' <<<"$result")
  NEW_TERM=$(jq -r '.terminal // empty' <<<"$result")
  [[ -n "$NEW_SPACE" && -n "$NEW_TAB" && -n "$NEW_TERM" ]] || die "herdr-app space.new returned incomplete IDs: $result"
  if [[ -n "${CREW_DRY_RUN:-}" ]]; then NEW_PANE=$(jq -r '.pane // "dry-pane"' <<<"$result")
  else NEW_PANE=$(pane_for_terminal "$NEW_TERM") || die "cannot find pane for terminal $NEW_TERM"; fi
}

create_tab() {
  local result
  result=$(mutj '{"tab":"tb-dry","terminal":"t-dry","pane":"p-dry"}' \
    herdr-app do tab.new --space "$1" --name "$2" --folder "$3" --argv "$4") || die "cannot create app tab $2"
  NEW_TAB=$(jq -r '.tab // empty' <<<"$result")
  NEW_TERM=$(jq -r '.terminal // empty' <<<"$result")
  [[ -n "$NEW_TAB" && -n "$NEW_TERM" ]] || die "herdr-app tab.new returned incomplete IDs: $result"
  if [[ -n "${CREW_DRY_RUN:-}" ]]; then NEW_PANE=$(jq -r '.pane // "dry-pane"' <<<"$result")
  else NEW_PANE=$(pane_for_terminal "$NEW_TERM") || die "cannot find pane for terminal $NEW_TERM"; fi
}

split_pane() {
  local result
  result=$(mutj '{"pane":"p-dry-split","terminal":"t-dry-split"}' \
    herdr-app do pane.split --direction "$2" --pane "$1" --argv "$3") || die "cannot split app pane $1"
  NEW_PANE=$(jq -r '.pane // empty' <<<"$result")
  NEW_TERM=$(jq -r '.terminal // empty' <<<"$result")
  [[ -n "$NEW_PANE" && -n "$NEW_TERM" ]] || die "herdr-app pane.split returned incomplete IDs: $result"
}

# target_space NAME FIRST_TAB CWD ARGV: reuse a live space or create it with its first real terminal.
target_space() {
  local name=$1 tab_name=$2 cwd=$3 argv=$4
  resolve_space
  TARGET_TAB=""; TARGET_TERM=""; TARGET_PANE=""
  if [[ -n "$WS" ]]; then return 0; fi
  create_space "$name" "$tab_name" "$argv" "$cwd"
  WS=$NEW_SPACE; TARGET_TAB=$NEW_TAB; TARGET_TERM=$NEW_TERM; TARGET_PANE=$NEW_PANE
}

# wait_ready TERM TIMEOUT: wait for a usable status, answering only Claude's known trust prompt.
wait_ready() {
  local terminal=$1 timeout=$2 elapsed=0 info status screen trust_answered=0
  while (( elapsed <= timeout )); do
    info=$(hc get "$terminal" --json 2>/dev/null || true)
    status=$(jq -r '.status.state // empty' <<<"$info" 2>/dev/null || true)
    case "$status" in
      idle|working|done) return 0 ;;
      blocked) return 1 ;;
    esac
    if [[ -z "$status" ]] || (( elapsed >= timeout - 2 )); then
      screen=$(hc read "$terminal" --lines 40 2>/dev/null || true)
      if (( !trust_answered )) && rg -qiF 'trust this folder' <<<"$screen"; then
        hc keys "$terminal" down enter >/dev/null 2>&1 || true
        trust_answered=1
      fi
    fi
    (( elapsed < timeout )) || break
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 2
}

# submit_term TERM NAME TEXT: send once, then recover a swallowed Enter only for visible pasted text.
submit_term() {
  local terminal=$1 name=$2 text=$3 before_turn info status turn screen first_line rc i
  SUBMIT_BLOCKED=0
  if [[ -n "${CREW_DRY_RUN:-}" ]]; then mut hc send "$terminal" "$text" >/dev/null; return 0; fi
  info=$(hc get "$terminal" --json 2>/dev/null || true)
  before_turn=$(jq -r '.turn // empty' <<<"$info" 2>/dev/null || true)
  if hc send "$terminal" "$text" >/dev/null 2>&1; then
    :
  else
    rc=$?
    case "$rc" in
      9) SUBMIT_BLOCKED=1; crew_warn "$name is blocked; needs a person"; return 1 ;;
      3) die "$name terminal $terminal is gone; relaunch the team" ;;
      *) die "cannot send first brief to $name (hc send exit $rc)" ;;
    esac
  fi
  for ((i = 0; i < 8; i++)); do
    sleep 1
    info=$(hc get "$terminal" --json 2>/dev/null || true)
    status=$(jq -r '.status.state // empty' <<<"$info" 2>/dev/null || true)
    turn=$(jq -r '.turn // empty' <<<"$info" 2>/dev/null || true)
    if [[ "$status" == working ]] || { [[ "$turn" =~ ^[0-9]+$ && "$before_turn" =~ ^[0-9]+$ ]] && (( turn > before_turn )); }; then
      return 0
    fi
  done
  screen=$(hc read "$terminal" --lines 40 2>/dev/null || true)
  first_line=$(head -1 <<<"$text")
  if [[ -n "$first_line" ]] && rg -qF -- "$first_line" <<<"$screen"; then
    hc keys "$terminal" enter >/dev/null 2>&1 || true
    info=$(hc get "$terminal" --json 2>/dev/null || true)
    status=$(jq -r '.status.state // empty' <<<"$info" 2>/dev/null || true)
    turn=$(jq -r '.turn // empty' <<<"$info" 2>/dev/null || true)
    if [[ "$status" == working ]] || { [[ "$turn" =~ ^[0-9]+$ && "$before_turn" =~ ^[0-9]+$ ]] && (( turn > before_turn )); }; then
      return 0
    fi
  fi
  crew_warn "$name did not start after brief submission; check terminal $terminal"
  return 1
}

# submit NAME TEXT: keep the say caller interface while sending through its saved terminal.
submit() {
  local terminal
  terminal=$(terminal_of "$1") || die "no saved terminal for $1 (start it with herdr-crew first)"
  submit_term "$terminal" "$1" "$2"
}

# agent_argv NAME RANK TASK JOB [SELECTION DEFINITION CONTEXT_HOOK COMPLETION_HOOK]
# Builds the native program argv and snapshots the same policy/hooks as the former Herdr start.
agent_argv() {
  local name=$1 rank=$2 task=$3 job=${4:-} selection=${5:-} definition native model effort env_hook context_hook="" context_command completion_hook settings ident
  if [[ -n "$selection" ]]; then AGENT_JSON=$selection; selection_fields; else agent_selection "$rank" "$job"; fi
  AGENT_SELECTION=$AGENT_JSON; model=$AGENT_MODEL; effort=$AGENT_EFFORT
  if [[ -n "${6:-}" ]]; then definition=$6; else definition=$(agent_definition "${job:-crew-$rank}") || die "cannot resolve agent definition"; fi
  AGENT_DEFINITION=$definition
  mkdir -p "$SDIR" || die "cannot create crew state directory"
  if [[ -n "${8:-}" ]]; then
    completion_hook=$8
    [[ "$completion_hook" == "$SDIR/$name.task-complete."* && -f "$completion_hook" && ! -L "$completion_hook" ]] || die "invalid saved completion hook; relaunch the team"
  else completion_hook=$(snapshot_hook "$(project_base)/hooks/task-complete.sh" "$name.task-complete") || die "cannot snapshot project completion hook"; fi
  AGENT_COMPLETION_HOOK=$completion_hook
  ident=${job:-$rank}
  set_env "$name" "$task" "$ident" "$AGENT_SELECTION"
  if [[ "$AGENT_KIND" == opencode ]]; then
    ARGV=(env "${ENVV[@]}" opencode --standalone)
    AGENT_CONTEXT_HOOK=""
    [[ -n "${CREW_DRY_RUN:-}" ]] || save_cmd "$name"
    return 0
  fi
  native=$(jq -c --arg name "crew-$rank" '{($name): ({description:.description, prompt:(.profileInstructions + (if .id == ("crew-" + .profile) then "" else "\n\n" + .instructions end)), tools:(.tools // []), disallowedTools:(.disallowedTools // [])} + (if .permissionMode then {permissionMode:.permissionMode} else {} end))}' <<<"$definition")
  if [[ -n "${7:-}" ]]; then
    context_hook=$7
    [[ "$context_hook" == "$SDIR/$name.context-limit."* && -f "$context_hook" && ! -L "$context_hook" ]] || die "invalid saved context hook; relaunch the team"
  else context_hook=$(snapshot_hook "$(project_base)/hooks/context-limit.sh" "$name.context-limit") || die "cannot snapshot project context hook"; fi
  AGENT_CONTEXT_HOOK=$context_hook
  env_hook=$(crew_env_hook "$name" "$task" "$ident" "$AGENT_SELECTION")
  printf -v context_command '%q' "$context_hook"
  settings=$(jq -nc --arg env_hook "$env_hook" --arg c "$context_command" --arg r "$rank" '{hooks:{SessionStart:[{hooks:[{type:"command",command:$env_hook}]}],PostToolUse:[{hooks:[{type:"command",command:$c}]}],UserPromptSubmit:[{hooks:[{type:"command",command:$c}]}]}} + (if $r == "member" then {permissions:{deny:["Bash(git push:*)","Bash(git merge:*)"]}} else {} end)')
  ARGV=(env "${ENVV[@]}" claude --agent "crew-$rank" -n "$name" --agents "$native")
  [[ -n "$model" && "$model" != inherit ]] && ARGV+=(--model "$model")
  [[ -n "$effort" ]] && ARGV+=(--effort "$effort")
  ARGV+=(--settings "$settings")
  [[ -n "${CREW_DRY_RUN:-}" ]] || save_cmd "$name"
}

# register_agent NAME RANK SPACE TAB TERM PANE LABEL TASK BRIEF JOB SELECTION DEFINITION CONTEXT_HOOK COMPLETION_HOOK
register_agent() {
  local name=$1 rank=$2 space=$3 tab=$4 terminal=$5 pane=$6 label=$7 task=$8 brief_text=$9 job=${10:-} selection=${11:-} definition=${12:-} context_hook=${13:-} completion_hook=${14:-} coordinator
  local ready_rc
  coordinator="$SLUG-manager"
  [[ "$name" != "$SLUG-manager" ]] || coordinator="$SLUG-lead"
  [[ -z "${CREW_DRY_RUN:-}" ]] || return 0
  if wait_ready "$terminal" 30; then :; else
    ready_rc=$?
    if (( ready_rc == 1 )); then crew_warn "$name is blocked; needs a person"
    else crew_warn "$name did not become ready; check terminal $terminal"; fi
    return 1
  fi
  mkdir -p "$SDIR" || die "cannot create crew state directory"
  printf 'rank=%s\njob=%s\nspace=%s\ntab=%s\nterminal=%s\npane=%s\nlabel=%s\ntask=%s\nselection=%s\ncoordinator=%s\ncontext_hook=%s\ncompletion_hook=%s\n' \
    "$rank" "$job" "$space" "$tab" "$terminal" "$pane" "$label" "$task" "$selection" "$coordinator" "$context_hook" "$completion_hook" >"$SDIR/$name.meta"
  printf '%s\n' "$brief_text" >"$SDIR/$name.brief"
  printf '%s\n' "$definition" >"$SDIR/$name.definition"
  submit_term "$terminal" "$name" "$brief_text"
}

# start_agent NAME RANK SPACE TAB TERM PANE LABEL TASK BRIEF JOB SELECTION DEFINITION CONTEXT_HOOK COMPLETION_HOOK
start_agent() {
  local name=$1 rank=$2 space=$3 tab=$4 terminal=$5 pane=$6 label=$7 task=$8 brief_text=$9 job=${10:-} selection=${11:-} definition=${12:-} context_hook=${13:-} completion_hook=${14:-} kind model effort
  AGENT_JSON=$selection; selection_fields
  kind=$AGENT_KIND; model=$AGENT_MODEL; effort=$AGENT_EFFORT
  crew_step "starting $name ($kind${model:+, $model}${effort:+, $effort})"
  register_agent "$name" "$rank" "$space" "$tab" "$terminal" "$pane" "$label" "$task" "$brief_text" "$job" "$selection" "$definition" "$context_hook" "$completion_hook"
}

# snapshot_hook SOURCE PREFIX: copy a project hook to a unique session path without replacing prior bytes.
snapshot_hook() {
  local source=$1 prefix=$2 snapshot
  [[ -f "$source" && ! -L "$source" ]] || return 1
  snapshot=$(mktemp "$SDIR/$prefix.XXXXXX") || return 1
  if ! cp "$source" "$snapshot" || ! chmod 700 "$snapshot"; then rm -f "$snapshot"; return 1; fi
  printf '%s' "$snapshot"
}

cmd_launch() {
  local spec=${1:-} instr team
  [[ -n "$spec" ]] || die "usage: launch <spec> - (spec: <rank>[@<persona>[+<persona>]] or a job persona)"
  shift
  parse_spec "$spec"
  if [[ "${1:-}" == - ]]; then instr=$(cat); else instr="$*"; fi
  [[ -n "${instr// /}" ]] || die "no instructions (pass them on stdin with '-')"

  # A review needs the pair branch, which a new task never has. Checked before any tsk, herdr or git call.
  if [[ "$RANK" != lead ]]; then
    team=$(team_of "$JOB") || die "job '$JOB' is in no team (see teams/*.conf)"
    [[ "$(conf "$team" worktree)" != pair-branch ]] || die 'review needs an existing pair task: run `herdr-crew team review T<n>` for a task that already has crew/T<n>-pair (the manager does this)'
  fi

  # Re-running lead uses saved app metadata and verifies its terminal still exists.
  local existing_term
  if [[ "$RANK" == lead ]] && existing_term=$(terminal_of "$SLUG-lead") && [[ -n "$existing_term" ]] && hc get "$existing_term" --json >/dev/null 2>&1; then
    cmd_say "$SLUG-lead" "$instr"
    return
  fi

  if [[ "$RANK" == lead ]]; then
    agent_selection lead ""; agent_check
    agent_selection manager ""; agent_check
    resolve_space
  else
    preflight_team "$team"
    resolve_space
  fi
  if [[ "$RANK" == lead ]]; then
    local lead="$SLUG-lead" manager="$SLUG-manager" root manager_selection manager_definition manager_context manager_completion lead_selection lead_definition lead_context lead_completion lead_tab lead_term manager_tab manager_term manager_pane label="crew $SLUG" lead_argv manager_argv board_argv
    resolve_space
    agent_argv "$lead" lead "" ""
    lead_selection=$AGENT_SELECTION; lead_definition=$AGENT_DEFINITION; lead_context=$AGENT_CONTEXT_HOOK; lead_completion=$AGENT_COMPLETION_HOOK
    lead_argv=$(app_argv_json)
    target_space "crew-$SLUG" "$label" "$REPO" "$lead_argv"
    export CREW_WS="$WS"
    if [[ -n "$TARGET_TAB" ]]; then lead_tab=$TARGET_TAB; lead_term=$TARGET_TERM; root=$TARGET_PANE
    else
      create_tab "$WS" "$label" "$REPO" "$lead_argv"
      lead_tab=$NEW_TAB; lead_term=$NEW_TERM; root=$NEW_PANE
    fi
    agent_argv "$manager" manager "" ""
    manager_selection=$AGENT_SELECTION; manager_definition=$AGENT_DEFINITION; manager_context=$AGENT_CONTEXT_HOOK; manager_completion=$AGENT_COMPLETION_HOOK
    manager_argv=$(app_argv_json)
    split_pane "$root" right "$manager_argv"
    manager_pane=$NEW_PANE; manager_term=$NEW_TERM; manager_tab=$lead_tab
    ARGV=(tsk); board_argv=$(app_argv_json)
    split_pane "$root" down "$board_argv"
    start_agent "$manager" manager "$WS" "$manager_tab" "$manager_term" "$manager_pane" "$label" "" "$(brief "$manager" manager "" "$lead" \
      "Wait for the lead to send you task numbers (T#) via herdr-crew say. Then spawn teams: herdr-crew team <team> <T#> [--persona <job>=<domain>]... Domain personas: $(persona_names). Never edit code." \
      "$REPO" "pragmatic-senior")" "" "$manager_selection" "$manager_definition" "$manager_context" "$manager_completion"
    start_agent "$lead" lead "$WS" "$lead_tab" "$lead_term" "$root" "$label" "" "$(brief "$lead" lead "" "$manager" "$instr" "$REPO" "$(slot_list "" "$DOMAINS")")" "" "$lead_selection" "$lead_definition" "$lead_context" "$lead_completion"
    crew_out "lead tab 'crew $SLUG' ready: $lead, $manager (board pane bottom-left)"
    return
  fi

  # Job persona: new tsk task from the instructions, then its team
  local T title out
  title=$(head -1 <<<"$instr" | cut -c1-80)
  out=$(mutj '{"number":1,"outcome":"created"}' tsk add --title="$title" --notes="$instr" -p "$REPO" --json) \
    || die "tsk add failed (see above)"
  T="T$(jq -r '.number // empty' <<<"$out")"
  [[ "$T" != T ]] || die "tsk add returned no task number: $out"
  mut tsk status "$T" ready >/dev/null
  crew_out "created task $T"
  if [[ -n "$DOMAINS" ]]; then
    cmd_team "$team" "$T" --persona "$JOB=${DOMAINS// /+}" "$instr"
  else
    cmd_team "$team" "$T" "$instr"
  fi
}

# cmd_team TEAM T# [--persona JOB=DOMAIN[+DOMAIN]]... [INSTR]: worktree, one tab, one pane per member, start + brief each agent
cmd_team() {
  local team=${1:?usage: team <team> <T#>} T=${2:?usage: team <team> <T#>} instr="" pmap="" e doms d
  local members wt base cwd path rank job n mates dir i m label space tab root argv_json
  local names=() ranks=() jobs=() panes=() terms=() selections=() definitions=() contexts=() completions=()
  shift 2
  while [[ $# -gt 0 ]]; do
    case $1 in
      --persona) [[ "${2:-}" == *=* ]] || die "--persona needs <job>=<domain>[+<domain>]"; pmap="$pmap $2"; shift 2 ;;
      *) instr=$1; shift ;;
    esac
  done
  [[ "$team" =~ ^[a-z][a-z0-9-]*$ ]] || die "invalid team '$team'"
  [[ -f "$(team_dir)/$team.conf" ]] || die "no team '$team'. teams: $(teams_list)"
  for e in $pmap; do
    doms=${e#*=}
    case " $(team_jobs "$team" | tr '\n' ' ')" in *" ${e%%=*} "*) ;; *) die "team '$team' has no job '${e%%=*}'. jobs: $(team_jobs "$team" | tr '\n' ' ')" ;; esac
    for d in ${doms//+/ }; do check_domain "$d"; done
  done
  preflight_team "$team"
  members=$(conf "$team" members); wt=$(conf "$team" worktree)
  [[ -n "$instr" ]] || instr=$(tsk list "$T" --json 2>/dev/null | jq -r '.[0].notes // ""' 2>/dev/null || true)
  [[ -n "$instr" ]] || instr="(read the task: tsk list $T --json)"
  cwd="$REPO"; path="$HOME/.herdr/worktrees/$SLUG/$T-$team"
  if [[ "$wt" == pair-branch ]]; then branch_exists "crew/$T-pair" || die "no branch crew/$T-pair: run 'team pair $T' first"; fi
  resolve_space
  case "$wt" in
    new|from-pair)
      if [[ -e "$path" ]]; then
        # A retained worktree must still be registered to this repo and branch.
        [[ "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)" == "$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)" &&
           "$(git -C "$path" symbolic-ref --short HEAD)" == "crew/$T-$team" ]] || die "unexpected worktree at $path"
      elif branch_exists "crew/$T-$team"; then
        mut git -C "$REPO" worktree add "$path" "crew/$T-$team" >&2
      else
        base=HEAD
        if [[ "$wt" == from-pair ]] && branch_exists "crew/$T-pair"; then base="crew/$T-pair"; fi
        mut git -C "$REPO" worktree add -b "crew/$T-$team" "$path" "$base" >&2
      fi
      cwd="$path" ;;
    pair-branch)  # read the pair's commit; --detach because the driver's worktree already holds the branch
      branch_exists "crew/$T-pair" || die "no branch crew/$T-pair: run 'team pair $T' first"
      # re-review reuses the worktree from the last round, moved to the pair's new commit
      if [[ -e "$path" ]]; then mut git -C "$path" checkout --detach "crew/$T-pair" >&2
      else mut git -C "$REPO" worktree add --detach "$path" "crew/$T-pair" >&2; fi
      cwd="$path" ;;
  esac

  for m in $members; do
    rank=${m%%@*}; job=""
    if [[ "$m" == *@* ]]; then job=${m#*@}; fi
    ranks+=("$rank"); jobs+=("$job"); names+=("$(agent_name "$T" "${job:-$rank}")")
  done
  # Create worktree first. Then the first argv becomes the space's real initial tab if needed.
  label="$T $team"
  for ((i = 0; i < ${#names[@]}; i++)); do
    agent_argv "${names[$i]}" "${ranks[$i]}" "$T" "${jobs[$i]}"
    selections+=("$AGENT_SELECTION"); definitions+=("$AGENT_DEFINITION")
    contexts+=("$AGENT_CONTEXT_HOOK"); completions+=("$AGENT_COMPLETION_HOOK")
    argv_json=$(app_argv_json)
    if (( i == 0 )); then
      target_space "crew-$SLUG" "$label" "$cwd" "$argv_json"
      export CREW_WS="$WS"
      space=$WS
      if [[ -n "$TARGET_TAB" ]]; then tab=$TARGET_TAB; terms+=("$TARGET_TERM"); panes+=("$TARGET_PANE")
      else
        create_tab "$space" "$label" "$cwd" "$argv_json"
        tab=$NEW_TAB; terms+=("$NEW_TERM"); panes+=("$NEW_PANE")
      fi
    else
      dir=down; if (( i == 1 )); then dir=right; fi
      split_pane "$root" "$dir" "$argv_json"
      panes+=("$NEW_PANE"); terms+=("$NEW_TERM")
    fi
    (( i != 0 )) || root=${panes[0]}
  done
  for ((i = 0; i < ${#names[@]}; i++)); do
    n=${names[$i]}; mates=""
    for m in "${names[@]}"; do [[ "$m" == "$n" ]] || mates="$mates $m"; done
    start_agent "$n" "${ranks[$i]}" "$space" "$tab" "${terms[$i]}" "${panes[$i]}" "$label" "$T" \
      "$(brief "$n" "${ranks[$i]}" "$T" "$mates" "$instr" "$cwd" "$(slot_list "${jobs[$i]}" "$(pmap_for "${jobs[$i]}")")")" \
      "${jobs[$i]}" "${selections[$i]}" "${definitions[$i]}" "${contexts[$i]}" "${completions[$i]}"
  done
  crew_out "team $team for $T in tab '$T $team' (agents: ${names[*]})"
}

# cmd_say AGENT MSG: send only to idle/done terminals; otherwise queue once on its task.
# Never exits non-zero because the recipient is busy.
queue_say() {
  local to=$1 msg=$2 state=$3 task=$4
  if [[ -n "$task" ]]; then
    mut tsk steps "$task" add "[msg from $ME to $to] $msg"
    crew_out "$to is ${state:-unknown}, message queued on $task (it reads it from the task steps)"
  else
    crew_warn "$to is ${state:-unknown} and has no task; message NOT delivered, send it again later"
  fi
}

cmd_say() {
  local to=$1 msg=$2 state="" task="" terminal="" info=""
  if [[ "$to" =~ ^[a-zA-Z0-9_-]+$ && -f "$SDIR/$to.meta" ]]; then task=$(sed -n 's/^task=//p' "$SDIR/$to.meta" | head -1); fi
  terminal=$(terminal_of "$to" 2>/dev/null || true)
  if [[ -n "$terminal" ]]; then
    info=$(hc get "$terminal" --json 2>/dev/null || true)
    state=$(jq -r '.status.state // empty' <<<"$info" 2>/dev/null || true)
    if [[ "$state" == working ]]; then
      info=$(hc wait "$terminal" --timeout 20 2>/dev/null || true)
      state=$(jq -r '.status | strings' <<<"$info" 2>/dev/null || true)
    fi
    if [[ "$state" == idle || "$state" == done ]]; then
      if submit "$to" "[from $ME] $msg"; then
        crew_out "sent to $to"
      elif (( SUBMIT_BLOCKED )); then
        queue_say "$to" "$msg" blocked "$task"
      else
        crew_warn "$to message delivery was not confirmed; inspect it before retrying"
      fi
      return 0
    fi
  fi
  queue_say "$to" "${msg:-}" "${state:-unknown}" "$task"
  return 0
}

cmd_read() {
  local name=${1:?usage: read <agent> [--lines N]} terminal
  shift
  terminal=$(terminal_of "$name") || die "no saved state for $name (start it with herdr-crew first)"
  hc read "$terminal" "$@"
}

cmd_wait() {
  local name=${1:?usage: wait <agent> [--timeout S]} terminal
  shift
  terminal=$(terminal_of "$name") || die "no saved state for $name (start it with herdr-crew first)"
  hc wait "$terminal" "$@"
}

cmd_mark() {
  local T=$1 st=$2 note=$3 result tmp coordinator completion_hook tab label
  [[ "$T" =~ ^T[0-9]+$ && "$ME" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid task or agent identity"
  case "$st" in ready|started|blocked|review|done) ;; *) die "invalid task status '$st'" ;; esac
  [[ -n "$note" ]] || die "mark requires a non-empty note"
  [[ ! -L "$SDIR" ]] || die "refusing symlink crew state directory"
  mkdir -p "$SDIR" || die "cannot create crew state directory"
  result="$SDIR/$ME.result.json"
  [[ ! -L "$result" ]] || die "refusing symlink result file"
  tmp=$(mktemp "$SDIR/.result.XXXXXX") || die "cannot write task result"
  if ! jq -n --arg agent "$ME" --arg task "$T" --arg status "$st" --arg note "$note" '{agent:$agent,task:$task,status:$status,note:$note}' >"$tmp"; then
    rm -f "$tmp"
    die "cannot encode task result"
  fi
  mv -f "$tmp" "$result" || { rm -f "$tmp"; die "cannot save task result"; }
  mut tsk status "$T" "$st"
  mut tsk steps "$T" add "$note"
  tab=$(sed -n 's/^tab=//p' "$SDIR/$ME.meta" 2>/dev/null | head -1) || true
  label=$(sed -n 's/^label=//p' "$SDIR/$ME.meta" 2>/dev/null | head -1) || true
  if [[ -n "$tab" && -n "$label" ]]; then
    mut herdr-app do tab.rename --id "$tab" --name "$label · $ME: $note"
  else
    crew_warn "no saved tab for $ME; task update saved without a tab rename"
  fi
  case "$st" in blocked|review|done)
    coordinator=$(sed -n 's/^coordinator=//p' "$SDIR/$ME.meta" 2>/dev/null | head -1) || true
    completion_hook=$(sed -n 's/^completion_hook=//p' "$SDIR/$ME.meta" 2>/dev/null | head -1) || true
    [[ "$coordinator" =~ ^[a-zA-Z0-9_-]+$ ]] || coordinator=${CREW_MANAGER:-}
    if [[ "$coordinator" =~ ^[a-zA-Z0-9_-]+$ && "$completion_hook" == "$SDIR/$ME.task-complete."* && -f "$completion_hook" && ! -L "$completion_hook" ]]; then
      /bin/bash "$completion_hook" "$result" "$ME" "$T" "$coordinator" "$SDIR" "$ROOT/bin/crew-say" || crew_warn "completion notification failed; result saved for retry"
    else crew_warn "completion coordinator is unavailable; result saved for retry"; fi ;;
  esac
}

# show_agent NAME SNAPSHOT: one line "name<TAB>state" when the saved terminal has a status
show_agent() { local st; st=$(terminal_status "$1" "$2"); if [[ -n "$st" ]]; then printf '%s\t%s\n' "$1" "$st"; fi; }

cmd_status() {
  local rows snapshot n st title job name
  if [[ "${1:-}" == --json ]]; then tsk list -p "$REPO" --json; return 0; fi
  rows=$(tsk list -p "$REPO" --json)
  if snapshot=$(hc ls --json 2>/dev/null); then :; else snapshot='{"terminals":[]}'; fi
  while IFS=$'\t' read -r n st title; do
    [[ -n "$n" ]] || continue
    printf 'T%s\t%s\t%s\n' "$n" "$st" "$title"
  done < <(jq -r '.[] | [(.number|tostring),(.status // "?"),(.title // "")] | @tsv' <<<"$rows" 2>/dev/null || true)
  for name in "$SLUG-lead" "$SLUG-manager"; do show_agent "$name" "$snapshot"; done
  for n in $(jq -r '.[].number // empty' <<<"$rows"); do
    for job in $(all_jobs); do show_agent "$(agent_name "T$n" "$job")" "$snapshot"; done
  done
}

cmd_close() {
  local T=$1 TEAM=${2:-} label space tabs tab d listing
  space=${CREW_WS:-${HERDR_WORKSPACE_ID:-}}
  [[ -n "$space" ]] || die "no workspace known: run close inside Herdr, or set CREW_WS"
  label="$T ..."; [[ -z "$TEAM" ]] || label="$T $TEAM"
  # Prefix matching also catches tabs renamed by mark; the trailing space keeps T70 distinct from T7.
  listing=$(herdr-app ls) || die "cannot list herdr-app spaces"
  tabs=$(jq -r --arg s "$space" --arg p "$T " '.spaces[]
    | select(.id == $s) | .tabs[]
    | select((.name // "") | startswith($p))
    | .id' <<<"$listing") || die "cannot read herdr-app tabs"
  [[ -n "$tabs" ]] || die "no tab labelled '$label'"
  for tab in $tabs; do mut herdr-app do tab.close --id "$tab" --confirmed true; done
  crew_out "closed $T tabs. Worktree kept. Remove only after you confirm:"
  if [[ -n "$TEAM" ]]; then
    d="$HOME/.herdr/worktrees/$SLUG/$T-$TEAM"
    [[ -e "$d" ]] && echo "  git -C $REPO worktree remove $d"
  else
    for d in "$HOME/.herdr/worktrees/$SLUG/$T-"*; do
      [[ -e "$d" ]] && echo "  git -C $REPO worktree remove $d"
    done
  fi
  return 0
}

# field_of KEY COL TEXT: column COL (tab separated) of the TEXT line whose first column is KEY
field_of() { awk -F'\t' -v k="$1" -v c="$2" '$1==k{print $c; exit}' <<<"$3"; }

# cmd_watch: feed for the Lead's Monitor. Prints one line per change, never repeats unchanged state.
# The first poll only sets the baseline, except tasks already blocked. CREW_WATCH_SECS sets the interval.
# CREW_WATCH_ONCE=1 stops after two polls (tests).
cmd_watch() {
  local secs=${CREW_WATCH_SECS:-20} polls=0 first=1 raw done_raw snapshot key st title old name new job names n f
  local tasks="" agents="" files="" p_tasks="" p_agents="" p_files=""
  trap 'printf "\n"; crew_out "watch stopped"; exit 130' INT
  while :; do
    # a failed read keeps the last snapshot, so a bad poll prints nothing
    # the default list hides done tasks, so the done list is read too
    if raw=$(tsk list -p "$REPO" --json 2>/dev/null) && done_raw=$(tsk list -p "$REPO" --done --json 2>/dev/null) && tasks=$(jq -rs 'add | .[] | "T\(.number)\t\(.status)\t\(.title)"' <<<"$raw"$'\n'"$done_raw" 2>/dev/null); then :; else tasks=$p_tasks; fi
    # agents: lead, manager, and every job agent of every task (same names as cmd_status)
    names="$SLUG-lead $SLUG-manager"
    if [[ -n "$tasks" ]]; then
      for key in $(cut -f1 <<<"$tasks"); do
        for job in $(all_jobs); do names="$names $(agent_name "$key" "$job")"; done
      done
    fi
    if snapshot=$(hc ls --json 2>/dev/null); then
      agents=""
      for name in $names; do
        st=$(terminal_status "$name" "$snapshot")
        [[ -z "$st" ]] || agents="$agents$name"$'\t'"$st"$'\n'
      done
    else agents=$p_agents; fi
    # handoff files: handoff-<agent>.md only; renamed copies (handoff-<agent>.<epoch>.md) have a dot
    files=$(ls "$SDIR" 2>/dev/null | sed -n 's/^handoff-\(.*\)\.md$/\1/p' | grep -v '\.' || true)

    while IFS=$'\t' read -r key st title; do
      [[ -n "$key" ]] || continue
      old=$(field_of "$key" 2 "$p_tasks")
      if [[ "$first" == 1 && "$st" == blocked ]]; then echo "$key start -> blocked: $title"
      elif [[ "$first" == 0 && "$st" != "$old" ]]; then echo "$key ${old:-new} -> $st: $title"; fi
    done <<<"$tasks"
    while IFS=$'\t' read -r key old title; do
      [[ -n "$key" ]] || continue
      if [[ "$first" == 0 && -z "$(field_of "$key" 2 "$tasks")" ]]; then echo "$key $old -> gone: $title"; fi
    done <<<"$p_tasks"
    while IFS=$'\t' read -r name new; do
      [[ -n "$name" ]] || continue
      old=$(field_of "$name" 2 "$p_agents")
      if [[ "$first" == 0 && "$new" != "$old" && ( "$new" == blocked || "$new" == done ) ]]; then echo "$name $new"; fi
    done <<<"$agents"
    while IFS=$'\t' read -r name _; do
      [[ -n "$name" ]] || continue
      if [[ "$first" == 0 && -z "$(field_of "$name" 2 "$agents")" ]]; then echo "$name gone"; fi
    done <<<"$p_agents"
    if [[ "$first" == 0 ]]; then
      for n in $files; do
        if ! grep -qxF "$n" <<<"$p_files"; then echo "handoff $n $SDIR/handoff-$n.md"; fi
      done
    fi

    p_tasks=$tasks; p_agents=$agents; p_files=$files; first=0
    polls=$((polls + 1))
    if [[ "${CREW_WATCH_ONCE:-}" == 1 ]] && (( polls >= 2 )); then return 0; fi
    sleep "$secs"
  done
}

# cmd_handoff "<status>" [< body]: saves the body from stdin as the handoff (or keeps the file already there),
# records it on the task, and tells the agent that restarts this one: manager for workers, lead for manager, manager for lead.
cmd_handoff() {
  local status=${1:?usage: handoff "<status>" < handoff text} f="$SDIR/handoff-$ME.md" body="" to
  [[ -t 0 ]] || body=$(cat)
  if [[ -n "$body" ]]; then mkdir -p "$SDIR"; printf '%s\n' "$body" >"$f"; fi
  [[ -f "$f" ]] || die "no handoff at $f. Pipe the handoff text on stdin."
  [[ -z "${CREW_TASK:-}" ]] || mut tsk steps "$CREW_TASK" add "[handoff] $ME: $status"
  if [[ "$ME" =~ -t[0-9]+- ]]; then to="$SLUG-manager"
  elif [[ "$ME" == "$SLUG-manager" ]]; then to="$SLUG-lead"
  else to="$SLUG-manager"; fi
  cmd_say "$to" "$ME hit the context limit. Handoff: $f. Restart it: herdr-crew restart $ME"
  crew_out "handoff saved to $f"
}

# wait_shell TERM TIMEOUT: wait for a null status and a visible shell prompt. 3 means the terminal is finished.
wait_shell() {
  local terminal=$1 timeout=$2 elapsed=0 info state status screen
  while (( elapsed <= timeout )); do
    info=$(hc get "$terminal" --json 2>/dev/null) || return 3
    state=$(jq -r '.state // empty' <<<"$info" 2>/dev/null || true)
    [[ "$state" != finished ]] || return 3
    status=$(jq -r '.status.state // empty' <<<"$info" 2>/dev/null || true)
    if [[ -z "$status" ]]; then
      screen=$(hc read "$terminal" --lines 20 2>/dev/null || true)
      if rg -q '[$#%❯] *$' <<<"$screen"; then return 0; fi
    fi
    (( elapsed < timeout )) || break
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

# restart_one NAME: reuse the saved terminal. Stop the agent, type the saved command into the wrapper shell,
# wait for readiness, then submit the saved brief with the handoff line. Never creates a tab.
restart_one() {
  local name=$1 terminal cmd rank job definition handoff brief rc=0
  terminal=$(terminal_of "$name") || die "no saved state for $name (start it with herdr-crew first)"
  [[ -f "$SDIR/$name.brief" && ! -L "$SDIR/$name.brief" ]] || die "no saved state for $name (start it with herdr-crew first)"
  cmd="$SDIR/$name.cmd"
  [[ -f "$cmd" && ! -L "$cmd" ]] || die "missing saved command for $name; relaunch the team"
  rank=$(sed -n 's/^rank=//p' "$SDIR/$name.meta"); job=$(sed -n 's/^job=//p' "$SDIR/$name.meta")
  [[ -f "$SDIR/$name.definition" && ! -L "$SDIR/$name.definition" ]] || die "missing saved definition; relaunch the team"
  definition=$(cat "$SDIR/$name.definition") || die "cannot read saved definition; relaunch the team"
  jq -se --arg rank "$rank" --arg id "${job:-crew-$rank}" 'length == 1 and (.[0] | type == "object" and .id == $id and .profile == $rank and (.description | type == "string") and (.profileInstructions | type == "string") and (.instructions | type == "string") and (.tools | type == "array" and all(.[]; type == "string")) and (if has("disallowedTools") then .disallowedTools | type == "array" and all(.[]; type == "string") else true end))' <<<"$definition" >/dev/null 2>&1 || die "invalid saved definition; relaunch the team"

  # A normal agent exit leaves the wrapper shell at a prompt. Sending /exit there would close the pane.
  wait_shell "$terminal" 0 || rc=$?
  case $rc in
    0) ;;
    3) die "$name: the agent's pane is gone; relaunch the team" ;;
    *)
      rc=0
      hc send "$terminal" /exit >/dev/null 2>&1 || rc=$?
      case $rc in
        0) ;;
        9) die "$name is blocked; needs a person" ;;
        3) die "$name terminal $terminal is gone; relaunch the team" ;;
        *) die "cannot send /exit to $name (hc send exit $rc)" ;;
      esac
      rc=0
      wait_shell "$terminal" 30 || rc=$?
      case $rc in
        0) ;;
        3) die "$name: the agent's pane is gone; relaunch the team" ;;
        *) die "$name terminal $terminal is still busy after 30s; try again later" ;;
      esac ;;
  esac

  rc=0
  hc send "$terminal" "$(cat "$cmd")" >/dev/null 2>&1 || rc=$?
  case $rc in
    0) ;;
    9) die "$name is blocked; needs a person" ;;
    3) die "$name terminal $terminal is gone; relaunch the team" ;;
    *) die "cannot start $name in terminal $terminal (hc send exit $rc)" ;;
  esac
  if wait_ready "$terminal" 30; then :; else
    rc=$?
    if (( rc == 1 )); then die "$name is blocked; needs a person"; fi
    die "$name did not become ready; check terminal $terminal"
  fi

  handoff="$SDIR/handoff-$name.md"
  brief=$(sed '/^Resume from your handoff: /d' "$SDIR/$name.brief")  # drop the resume line of an earlier restart
  if [[ -f "$handoff" ]]; then brief="$brief"$'\n'"Resume from your handoff: $handoff. Read it first. The board and the handoff show work already done: do not redo it, and do not create tasks that already exist."; fi
  printf '%s\n' "$brief" >"$SDIR/$name.brief" || die "cannot save the restart brief for $name"
  submit_term "$terminal" "$name" "$brief" || die "$name did not accept the brief; check terminal $terminal"
  crew_out "restarted $name"
}

# cmd_restart AGENT|T#: restart one agent, or every saved agent of a task
cmd_restart() {
  local who=${1:?usage: restart <agent|T#>} m
  if [[ "$who" =~ ^T[0-9]+$ ]]; then
    for m in "$SDIR"/*.meta; do
      [[ -e "$m" ]] || continue
      if grep -qx "task=$who" "$m"; then restart_one "$(basename "$m" .meta)"; fi
    done
  else
    restart_one "$who"
  fi
}

# Configuration is local and works without Herdr or tsk installed.
source "$ROOT/lib/agent-definitions.sh"
source "$ROOT/lib/project-config.sh"
source "$ROOT/lib/agent-config.sh"

# Global options come before the command, so an instruction can never look like one.
while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -V|--version) crew_version; exit 0 ;;
    --dry-run) export CREW_DRY_RUN=1; shift ;;
    *) break ;;
  esac
done
sub=${1:-}; [[ $# -gt 0 ]] && shift
# show_help NAME: one command's help text, or a failure that names the command.
show_help() { "usage_$1" 2>/dev/null || die "unknown command '$1'. Run: herdr-crew help"; }
# Pure-text paths run before every dependency check, so help and version work on a
# machine with no jq, tsk or herdr. Repo and slug resolution above still needs git.
case "$sub" in
  "") usage >&2; exit 1 ;;
  help) [[ $# -gt 0 ]] && show_help "$1" || usage; exit 0 ;;
esac
if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then show_help "$sub"; exit 0; fi
# completion prints a static script, so it needs no runtime either.
[[ "$sub" == completion ]] && { cmd_completion "$@"; exit 0; }
command -v jq >/dev/null || die "jq not found on PATH (install: brew install jq)"
if [[ "$sub" == configure ]]; then cmd_configure "$@"; exit; fi
if [[ "$sub" == init || "$sub" == upgrade ]]; then project_command "$sub" "$@"; exit; fi
for c in tsk herdr; do command -v "$c" >/dev/null || die "$c not found on PATH (tsk: brew install smarzban/tap/tsk; herdr: install Herdr first)"; done
case "$sub" in
  launch|team)
    project_root
    if [[ ! -f "$CONFIG_ROOT/.herdr-crew/baseline.json" && -z "${CREW_DRY_RUN:-}" ]]; then
      project_command init >/dev/null
    fi
    config_load
    load_definitions ;;
esac
case "$sub" in
  launch)  cmd_launch "$@" ;;
  team)    cmd_team "$@" ;;
  say)     cmd_say "$@" ;;
  read)    cmd_read "$@" ;;
  wait)    cmd_wait "$@" ;;
  mark)    cmd_mark "$@" ;;
  status)  cmd_status "$@" ;;
  close)   cmd_close "$@" ;;
  watch)   cmd_watch "$@" ;;
  handoff) cmd_handoff "$@" ;;
  restart) cmd_restart "$@" ;;
  *) usage >&2; die "unknown command '$sub'. Run: herdr-crew help" ;;
esac
